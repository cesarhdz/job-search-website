---
import Layout from '../../layouts/Layout.astro';

const sections = [
  { id:'prepararte', order:'01', title:'Prepararte', description:'Construye una base clara antes de empezar a buscar.', topics:[{label:'Define qué buscas'},{label:'Construye tu perfil profesional'},{label:'Prepara tus materiales'},{label:'Configura tu sistema'}]},
  { id:'encontrar-oportunidades', order:'02', title:'Encontrar oportunidades', description:'Descubre vacantes sin tener que revisar todo Internet.', topics:[{label:'Fuentes',href:`${import.meta.env.BASE_URL}fuentes/`},{label:'Búsquedas y palabras clave'},{label:'Alertas'},{label:'Networking y referrals'}]},
  { id:'decidir-y-aplicar', order:'03', title:'Decidir y aplicar', description:'Convierte muchas vacantes en pocas decisiones buenas.', topics:[{label:'Evalúa el fit'},{label:'Evalúa la empresa'},{label:'Prioriza y haz triage'},{label:'Prepara la aplicación'}]},
  { id:'avanzar-y-cerrar', order:'04', title:'Avanzar y cerrar', description:'Maneja el proceso después de aplicar y lleva cada oportunidad hasta una decisión.', topics:[{label:'Tracking y follow-up'},{label:'Entrevistas'},{label:'Feedback y aprendizaje'},{label:'Oferta y cierre'}]},
];
---

<Layout title="Guía para buscar trabajo con IA" description="Cuatro pasos para organizar una búsqueda de trabajo usando IA sin perder el control.">
  <section class="hero">
    <p class="eyebrow">Guía de búsqueda</p>
    <h1>Cuatro pasos para avanzar en tu búsqueda.</h1>
    <p class="lede">Empieza donde estás. Cada paso reúne sólo la orientación, los recursos y las herramientas que necesitas para seguir avanzando.</p>
  </section>
  <section class="section guide-sections">
    {sections.map((section) => (
      <article class="guide-section" id={section.id}>
        <div><p class="stage-number">{section.order}</p><h2>{section.title}</h2><p>{section.description}</p></div>
        <ol class="topic-list">
          {section.topics.map((topic) => <li>{topic.href ? <a href={topic.href}>{topic.label} →</a> : topic.label}</li>)}
        </ol>
      </article>
    ))}
  </section>
</Layout>
