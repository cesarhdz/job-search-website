---
import Layout from '../../../layouts/Layout.astro';

const topics = [
  {
    title: 'Define qué buscas',
    href: 'definir-que-buscas',
  },
  {
    title: 'Construye tu perfil profesional',
    href: 'perfil-profesional',
  },
  {
    title: 'Prepara tus materiales',
    href: 'materiales',
  },
  {
    title: 'Configura tu sistema',
    href: 'sistema',
  },
];
---

<Layout title="Prepararte" description="Define tu búsqueda, construye tu perfil, prepara tus materiales y configura un sistema antes de empezar a aplicar.">
  <section class="section guide-section section-overview">
    <div>
      <p class="stage-number">01</p>
      <h1>Prepararte</h1>
      <p class="lede">
        Construye una base clara antes de empezar a buscar. No necesitas tener todo resuelto: necesitas suficiente claridad para que cada búsqueda, evaluación y aplicación parta del mismo contexto.
      </p>
    </div>
    <ol class="topic-list">
      {topics.map((topic) => (
        <li><a href={`${import.meta.env.BASE_URL}guia/prepararte/${topic.href}/`}>{topic.title}</a></li>
      ))}
    </ol>
  </section>
</Layout>
