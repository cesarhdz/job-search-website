---
import Layout from '../layouts/Layout.astro';

const steps = [
  {
    order: '01',
    title: 'Prepararte',
    description: 'Define qué buscas, construye tu perfil y deja listos tus materiales y tu sistema.',
    href: 'prepararte',
  },
  {
    order: '02',
    title: 'Encontrar oportunidades',
    description: 'Elige buenas fuentes, mejora tus búsquedas y usa alertas y networking con intención.',
    href: 'encontrar-oportunidades',
  },
  {
    order: '03',
    title: 'Decidir y aplicar',
    description: 'Evalúa el fit y la empresa, prioriza oportunidades y prepara cada aplicación.',
    href: 'decidir-y-aplicar',
  },
  {
    order: '04',
    title: 'Avanzar y cerrar',
    description: 'Da seguimiento, prepara entrevistas, aprende del proceso y evalúa ofertas.',
    href: 'avanzar-y-cerrar',
  },
];
---

<Layout>
  <section class="hero">
    <p class="eyebrow">México primero · IA como herramienta de trabajo</p>
    <h1>Busca trabajo con IA, sin perder el control.</h1>
    <p class="lede">
      Una guía práctica para usar IA durante toda tu búsqueda: desde definir qué buscas hasta cerrar una oferta.
    </p>
  </section>

  <section class="section steps-section">
    <p class="eyebrow">¿En qué parte de tu búsqueda estás?</p>
    <div class="steps-grid">
      {steps.map((step) => (
        <a class="step-card" href={`${import.meta.env.BASE_URL}guia/#${step.href}`}>
          <p class="stage-number">{step.order}</p>
          <h2>{step.title}</h2>
          <p>{step.description}</p>
          <span class="step-link">Ver este paso →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section principle">
    <p class="eyebrow">La idea</p>
    <h2>La IA puede buscar, analizar, escribir y preparar. Tú mantienes las decisiones.</h2>
    <p class="lede">
      El sitio reúne orientación, recursos curados y herramientas para avanzar más rápido sin delegar el control de tu búsqueda.
    </p>
  </section>
</Layout>
