---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const stages = (await getCollection('stages')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Job Search Guide — Job Search Commons" description="A concise path through the job-search process.">
  <section class="hero">
    <p class="eyebrow">Job Search Guide</p>
    <h1>A clear path through the search.</h1>
    <p class="lede">
      Seven stages. Each one will contain only the guidance, resources, and tools that earn their place.
    </p>
  </section>

  <section class="section">
    <div class="grid">
      {stages.map((stage) => (
        <article class="card">
          <p class="stage-number">{String(stage.data.order).padStart(2, '0')}</p>
          <h2>{stage.data.title}</h2>
          <p>{stage.data.description}</p>
          <strong>{stage.data.goal}</strong>
        </article>
      ))}
    </div>
  </section>
</Layout>
