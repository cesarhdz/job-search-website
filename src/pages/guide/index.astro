---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const stages = (await getCollection('stages')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Guía para buscar trabajo con IA" description="Una ruta corta y práctica para organizar una búsqueda de trabajo desde México.">
  <section class="hero">
    <p class="eyebrow">Guía de búsqueda</p>
    <h1>Una ruta clara para buscar trabajo.</h1>
    <p class="lede">
      Siete etapas. En cada una queremos dejar sólo la orientación, los recursos y las herramientas que realmente aporten.
    </p>
  </section>

  <section class="section">
    <div class="grid">
      {stages.map((stage) => (
        <article class="card">
          <p class="stage-number">{String(stage.data.order).padStart(2, '0')}</p>
          <h2>{stage.data.title}</h2>
          <p>{stage.data.description}</p>
          <strong>{stage.data.goal}</strong>
        </article>
      ))}
    </div>
  </section>
</Layout>
