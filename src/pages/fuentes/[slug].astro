---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.filter((source) => source.data.published).map((source) => ({ params: { slug: source.id }, props: { source } }));
}
const { source } = Astro.props;
const data = source.data;
const typeLabels = { company:'Empresa', agency:'Agencia / recruiter', ats:'ATS', aggregator:'Bolsa / agregador', email:'Email', web:'Web' };
---

<Layout title={`${data.name} — Fuentes`} description={data.description ?? `Información sobre ${data.name} como fuente para encontrar oportunidades.`}>
  <section class="hero compact-hero">
    <p class="eyebrow">{typeLabels[data.type]} · {data.status === 'reviewed' ? 'Revisada' : 'Candidata'}</p>
    <h1>{data.name}</h1>
    <p class="lede">{data.description ?? 'Esta fuente forma parte del inventario inicial y todavía está pendiente de revisión editorial.'}</p>
    <div class="actions">
      {data.url && <a class="button primary" href={data.url} rel="noreferrer">Abrir sitio oficial ↗</a>}
      <a class="button" href={`${import.meta.env.BASE_URL}fuentes/`}>Volver a fuentes</a>
    </div>
  </section>
  <section class="section source-detail">
    <dl>
      <div><dt>Tipo</dt><dd>{typeLabels[data.type]}</dd></div>
      <div><dt>Estado editorial</dt><dd>{data.status === 'reviewed' ? 'Revisada' : 'Pendiente de revisión'}</dd></div>
      {data.bestFor && <div><dt>Mejor para</dt><dd>{data.bestFor}</dd></div>}
      {data.alerts !== undefined && <div><dt>Alertas</dt><dd>{data.alerts ? 'Sí' : 'No'}</dd></div>}
      {data.accountRequired !== undefined && <div><dt>Cuenta requerida</dt><dd>{data.accountRequired ? 'Sí' : 'No'}</dd></div>}
      {data.cost && <div><dt>Costo</dt><dd>{data.cost}</dd></div>}
    </dl>
    {data.limitations.length > 0 && <div class="detail-block"><h2>Limitaciones</h2><ul>{data.limitations.map((item) => <li>{item}</li>)}</ul></div>}
  </section>
</Layout>
