---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSources = await getCollection('sources');
const publishedSources = allSources.filter((source) => source.data.published);
const visibleSources = publishedSources.length > 0 ? publishedSources : allSources;
const isPreview = publishedSources.length === 0;
const typeLabels = { company:'Empresas', agency:'Agencias', ats:'ATS', aggregator:'Bolsas y agregadores', email:'Email', web:'Web y comunidades' };
const availableTypes = [...new Set(visibleSources.map((source) => source.data.type))];
---

<Layout title="Fuentes para encontrar trabajo" description="Catálogo curado de fuentes para encontrar oportunidades de trabajo desde México.">
  <section class="hero compact-hero">
    <p class="eyebrow">Encontrar oportunidades</p>
    <h1>Fuentes</h1>
    <p class="lede">Encuentra lugares que vale la pena revisar según el tipo de búsqueda que estás haciendo. Combina distintas fuentes en lugar de depender de un solo sitio.</p>
  </section>

  <section class="section source-explorer">
    {isPreview && <div class="notice"><strong>Catálogo en construcción.</strong> Puedes explorar las fuentes candidatas mientras terminamos su revisión editorial.</div>}

    <div class="source-toolbar">
      <label for="source-search">Buscar fuentes</label>
      <input id="source-search" class="source-search" type="search" placeholder="LinkedIn, remoto, agencia…" />
    </div>

    <div class="source-filters" aria-label="Tipos de fuentes">
      <button class="source-filter is-active" type="button" data-type="">Todas</button>
      {availableTypes.map((type) => <button class="source-filter" type="button" data-type={type}>{typeLabels[type]}</button>)}
    </div>

    <div class="source-grid" id="source-grid">
      {visibleSources.map((source) => (
        <article class="source-card" data-type={source.data.type} data-source={`${source.data.name} ${source.data.type} ${source.data.description ?? ''} ${source.data.markets.join(' ')} ${source.data.profiles.join(' ')} ${source.data.workModes.join(' ')}`.toLowerCase()}>
          <p class="source-type">{typeLabels[source.data.type]}</p>
          <h2><a href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>{source.data.name}</a></h2>
          <p>{source.data.description ?? (isPreview ? 'Pendiente de revisión editorial.' : '')}</p>
          <a class="text-link" href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>Ver fuente →</a>
        </article>
      ))}
    </div>
    <p id="source-empty" class="source-empty" hidden>No encontramos fuentes con esos criterios.</p>
  </section>

  <section class="section source-types-inline">
    <p class="eyebrow">Tipos de fuentes</p>
    <h2>No todas las fuentes sirven para lo mismo.</h2>
    <div class="type-summary-grid">
      <div><h3>Bolsas y agregadores</h3><p>Sirven para explorar el mercado y mantener búsquedas recurrentes.</p></div>
      <div><h3>ATS</h3><p>Ayudan a encontrar vacantes publicadas directamente por empresas.</p></div>
      <div><h3>Agencias</h3><p>Conectan perfiles con empresas y pueden concentrarse en mercados específicos.</p></div>
      <div><h3>Empresas</h3><p>Career pages de marcas grandes que vale la pena seguir directamente.</p></div>
    </div>
  </section>

  <script>
    const input = document.querySelector('#source-search');
    const cards = [...document.querySelectorAll('[data-source]')];
    const filters = [...document.querySelectorAll('[data-type]')];
    const empty = document.querySelector('#source-empty');
    let activeType = '';

    const update = () => {
      const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
      let visible = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matchesQuery = card.dataset.source?.includes(query) ?? false;
        const matchesType = !activeType || card.dataset.type === activeType;
        card.hidden = !(matchesQuery && matchesType);
        if (!card.hidden) visible += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = visible > 0;
    };

    input?.addEventListener('input', update);
    filters.forEach((filter) => filter.addEventListener('click', () => {
      if (!(filter instanceof HTMLButtonElement)) return;
      activeType = filter.dataset.type ?? '';
      filters.forEach((item) => item.classList.toggle('is-active', item === filter));
      update();
    }));
  </script>
</Layout>
