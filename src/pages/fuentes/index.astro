---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSources = await getCollection('sources');
const publishedSources = allSources.filter((source) => source.data.published);
const visibleSources = publishedSources.length > 0 ? publishedSources : allSources;
const isPreview = publishedSources.length === 0;
const groups = [
  { type: 'aggregator', title: 'Bolsas y agregadores', description: 'Explora el mercado y mantén búsquedas recurrentes en catálogos amplios de vacantes.' },
  { type: 'ats', title: 'ATS', description: 'Encuentra vacantes publicadas directamente por empresas en sus sistemas de contratación.' },
  { type: 'agency', title: 'Agencias', description: 'Conecta con recruiters y agencias que trabajan mercados o perfiles específicos.' },
  { type: 'company', title: 'Empresas', description: 'Sigue directamente las career pages de marcas grandes que te interesen.' },
];
---

<Layout title="Fuentes para encontrar trabajo" description="Catálogo curado de fuentes para encontrar oportunidades de trabajo desde México.">
  <section class="hero compact-hero">
    <p class="eyebrow">Encontrar oportunidades</p>
    <h1>Fuentes</h1>
    <p class="lede">Encuentra lugares que vale la pena revisar según el tipo de búsqueda que estás haciendo. Combina distintas fuentes en lugar de depender de un solo sitio.</p>
  </section>

  <section class="section source-explorer">
    {isPreview && <div class="notice"><strong>Catálogo en construcción.</strong> Puedes explorar las fuentes candidatas mientras terminamos su revisión editorial.</div>}

    <div class="source-search-wrap">
      <span class="source-search-icon" aria-hidden="true">⌕</span>
      <input id="source-search" class="source-search" type="search" aria-label="Buscar fuentes" placeholder="Buscar fuentes…" />
    </div>

    <div id="source-results">
      {groups.map((group) => {
        const sources = visibleSources.filter((source) => source.data.type === group.type);
        if (sources.length === 0) return null;
        return (
          <section class="source-group" data-group={group.type}>
            <header class="source-group-header">
              <h2>{group.title}</h2>
              <p>{group.description}</p>
            </header>
            <div class="source-grid">
              {sources.map((source) => (
                <article class="source-card" data-source={`${source.data.name} ${source.data.description ?? ''} ${source.data.markets.join(' ')} ${source.data.profiles.join(' ')} ${source.data.workModes.join(' ')}`.toLowerCase()}>
                  <h3><a href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>{source.data.name}</a></h3>
                  <p>{source.data.description ?? (isPreview ? 'Pendiente de revisión editorial.' : '')}</p>
                  <a class="text-link" href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>Ver fuente →</a>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
    <p id="source-empty" class="source-empty" hidden>No encontramos fuentes con esa búsqueda.</p>
  </section>

  <script>
    const input = document.querySelector('#source-search');
    const groups = [...document.querySelectorAll('[data-group]')];
    const empty = document.querySelector('#source-empty');

    const update = () => {
      const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
      let totalVisible = 0;

      groups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        const cards = [...group.querySelectorAll('[data-source]')];
        let groupVisible = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const matches = card.dataset.source?.includes(query) ?? false;
          card.hidden = !matches;
          if (matches) groupVisible += 1;
        });

        group.hidden = groupVisible === 0;
        totalVisible += groupVisible;
      });

      if (empty instanceof HTMLElement) empty.hidden = totalVisible > 0;
    };

    input?.addEventListener('input', update);
  </script>
</Layout>
