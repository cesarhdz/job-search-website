---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSources = await getCollection('sources');
const publishedSources = allSources.filter((source) => source.data.published);
const typeLabels = { company:'Empresa', agency:'Agencia / recruiter', ats:'ATS', aggregator:'Bolsa / agregador', email:'Email', web:'Web' };
---

<Layout title="Fuentes para encontrar trabajo" description="Catálogo curado de fuentes para encontrar oportunidades de trabajo desde México.">
  <section class="hero compact-hero">
    <p class="eyebrow">Encontrar oportunidades</p>
    <h1>Fuentes</h1>
    <p class="lede">Encuentra lugares que vale la pena revisar según el tipo de búsqueda que estás haciendo. La idea no es revisar todo Internet, sino construir una lista pequeña que consistentemente te dé buenas oportunidades.</p>
    <div class="actions"><a class="button" href={`${import.meta.env.BASE_URL}fuentes/tipos/`}>Entender los tipos de fuentes</a></div>
  </section>

  <section class="section">
    {publishedSources.length === 0 && <div class="notice"><strong>Catálogo en construcción.</strong> Estamos revisando las fuentes antes de publicarlas aquí.</div>}
    {publishedSources.length > 0 && <div class="source-toolbar">
      <label for="source-search">Buscar en el catálogo</label>
      <input id="source-search" class="source-search" type="search" placeholder="LinkedIn, remoto, agencia…" />
    </div>}
    <div class="source-grid" id="source-grid">
      {publishedSources.map((source) => (
        <article class="source-card" data-source={`${source.data.name} ${source.data.type} ${source.data.description ?? ''}`.toLowerCase()}>
          <p class="source-type">{typeLabels[source.data.type]}</p>
          <h2><a href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>{source.data.name}</a></h2>
          <p>{source.data.description ?? 'Fuente pendiente de revisión editorial.'}</p>
          <a class="text-link" href={`${import.meta.env.BASE_URL}fuentes/${source.id}/`}>Ver fuente →</a>
        </article>
      ))}
    </div>
  </section>

  <script>
    const input = document.querySelector('#source-search');
    const cards = document.querySelectorAll('[data-source]');
    input?.addEventListener('input', (event) => {
      const query = (event.target instanceof HTMLInputElement ? event.target.value : '').trim().toLowerCase();
      cards.forEach((card) => {
        if (card instanceof HTMLElement) card.hidden = !card.dataset.source?.includes(query);
      });
    });
  </script>
</Layout>
